#!/usr/bin/env bash
set -euo pipefail

PACKAGE_NAME="helloworld-rust-binding"
RUN_REDTEST_VERSION="4"
COVERAGE=no

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
LOG_DIR="/var/log/redtest/${PACKAGE_NAME}"
LIB_DIR="/usr/redpesk/${PACKAGE_NAME}/lib"
INSTALLED_BINDING="${LIB_DIR}/${PACKAGE_NAME}.so"
COVERAGE_SOURCE="${SCRIPT_DIR}/sources/src/lib.rs"

mkdir -p "${LOG_DIR}"

echo "--- run-redtest version ${RUN_REDTEST_VERSION} ---"

BINDING="${INSTALLED_BINDING}"

if [[ ! -f "${INSTALLED_BINDING}" ]]; then
    echo "ERROR: installed binding not found: ${INSTALLED_BINDING}" >&2
    exit 1
fi

if [[ "${COVERAGE}" == "yes" ]]; then
    if [[ ! -f "${COVERAGE_SOURCE}" ]]; then
        echo "ERROR: coverage source not found: ${COVERAGE_SOURCE}" >&2
        exit 1
    fi

    command -v llvm-profdata >/dev/null 2>&1 || {
        echo "ERROR: llvm-profdata is required when coverage is enabled" >&2
        exit 1
    }

    command -v llvm-cov >/dev/null 2>&1 || {
        echo "ERROR: llvm-cov is required when coverage is enabled" >&2
        exit 1
    }

    rm -f \
        "${LOG_DIR}"/*.profraw \
        "${LOG_DIR}/coverage.profdata" \
        "${LOG_DIR}/coverage.log"

    export LLVM_PROFILE_FILE="${LOG_DIR}/${PACKAGE_NAME}-%p.profraw"
fi

LD_LIBRARY_PATH="${LIB_DIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    python3 "${SCRIPT_DIR}/tests.py" --tap \
    | tee "${LOG_DIR}/helloworld-rust.tap" 2>&1

test -f "${LOG_DIR}/helloworld-rust.tap" \
    && grep -viq '^not ok' "${LOG_DIR}/helloworld-rust.tap"

if [[ "${COVERAGE}" == "yes" ]]; then
    mapfile -d '' PROFRAW_FILES < <(
        find "${LOG_DIR}" -maxdepth 1 -type f -name '*.profraw' -print0 | sort -z
    )

    if [[ ${#PROFRAW_FILES[@]} -eq 0 ]]; then
        echo "ERROR: no LLVM .profraw files were generated" >&2
        exit 1
    fi

    llvm-profdata merge \
        -sparse \
        "${PROFRAW_FILES[@]}" \
        -o "${LOG_DIR}/coverage.profdata"

    "${SCRIPT_DIR}/llvm-total.sh" \
        "${BINDING}" \
        "${LOG_DIR}/coverage.profdata" \
        "${COVERAGE_SOURCE}" \
        | tee "${LOG_DIR}/coverage.log"

    echo "--- LLVM coverage artifacts exported to ${LOG_DIR} ---"
fi
